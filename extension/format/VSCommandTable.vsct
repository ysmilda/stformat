<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="format">
    <Groups>
      <Group guid="format" id="MyMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="Tools"/>
      </Group>
      <!-- Right-click menu of code editors. -->
      <Group guid="format" id="EditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
      <!-- Right-click menu of the solution node in Solution Explorer. -->
      <Group guid="format" id="SolutionContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE"/>
      </Group>
    </Groups>

    <!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
    <Buttons>
      <Button guid="format" id="MyCommand" priority="0x0100" type="Button">
        <Parent guid="format" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="StatusInformation" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Format Structured Text</ButtonText>
          <LocCanonicalName>.format.Format</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="format" id="FormatSolutionCommand" priority="0x0101" type="Button">
        <Parent guid="format" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Solution" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Format Solution</ButtonText>
          <LocCanonicalName>.format.FormatSolution</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="format" id="MyCommand" priority="0x0100">
      <Parent guid="format" id="EditorContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="format" id="FormatSolutionCommand" priority="0x0100">
      <Parent guid="format" id="SolutionContextGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="format" value="{030fb4a7-a21d-4b36-a28d-ffc41b84fbfc}">
      <IDSymbol name="MyMenuGroup" value="0x0001" />
      <IDSymbol name="EditorContextGroup" value="0x0002" />
      <IDSymbol name="SolutionContextGroup" value="0x0003" />
      <IDSymbol name="MyCommand" value="0x0100" />
      <IDSymbol name="FormatSolutionCommand" value="0x0101" />
    </GuidSymbol>
  </Symbols>
</CommandTable>

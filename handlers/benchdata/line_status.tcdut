<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_LineStatus" Id="{718293a4-b5c6-4d7e-8f90-012a3b4c5d6e}">
    <Declaration><![CDATA[TYPE ST_LineStatus :
STRUCT
	iProduced : INT;
	iRejected : INT;
	fAvailability : LREAL;
	sFault : STRING(80);
	tLastChange : TIME;
	arrStationBusy : ARRAY[1..3] OF BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
  <DUT Name="ST_AxisConfig" Id="{8293a4b5-c6d7-4e8f-9012-3a4b5c6d7e8f}">
    <Declaration><![CDATA[TYPE ST_AxisConfig :
STRUCT
	fVelocity : LREAL;
	fAcceleration : LREAL;
	fDeceleration : LREAL;
	tTimeout : TIME;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
  <DUT Name="ST_Diagnostics" Id="{93a4b5c6-d7e8-4f90-1234-5b6c7d8e9f0}">
    <Declaration><![CDATA[TYPE ST_Diagnostics :
UNION
	sText : STRING(32);
	iCode : INT;
	arrWords : ARRAY[0..3] OF WORD;
END_UNION
END_TYPE]]></Declaration>
  </DUT>
  <DUT Name="ST_RecipeEntry" Id="{a4b5c6d7-e8f9-4012-2345-6c7d8e9f0a1b}">
    <Declaration><![CDATA[TYPE ST_RecipeEntry :
STRUCT
	sName : STRING(32);
	fSetpoint : LREAL;
	iFlags : WORD;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>